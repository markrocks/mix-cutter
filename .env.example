# Copy this file to .env and fill in the values.

# Port for the local web app. Your phone uses http://<your-mac-ip>:PORT
PORT=4317
# 0.0.0.0 = reachable from phones on the same Wi-Fi. Use 127.0.0.1 for desktop only.
HOST=0.0.0.0

# Where finished song folders are written (default: ~/Music/Mix Cutter).
# Can also be changed in the app's Settings.
# OUTPUT_DIR=/Users/you/Music/Mix Cutter

# --- SoundCloud API app (https://soundcloud.com/you/apps) ---
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Must EXACTLY match the redirect URI registered on your SoundCloud app.
SOUNDCLOUD_REDIRECT_URI=http://localhost:4317/auth/soundcloud/callback

# Set to 1 to simulate SoundCloud uploads without calling the API (for testing).
SOUNDCLOUD_DRY_RUN=0
